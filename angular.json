{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "koia": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/koia"
            },
            "index": "src/index.html",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": [
              "zone.js"
            ],
            "assets": [
              "src/intro",
              "src/.htaccess",
              "src/assets",
              "src/WEB-INF",
              "src/web.config"
            ],
            "styles": [
              "node_modules/pivottable/dist/pivot.css",
              "src/assets/themes/koia-theme.scss",
              "src/styles.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/assets/themes/scss"
              ]
            },
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/jquery-ui-dist/jquery-ui.min.js",
              "node_modules/pivottable/dist/pivot.min.js"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {},
            "test": {
              "aot": false,
              "polyfills": [
                "zone.js",
                "zone.js/testing",
                "zone.js/plugins/vitest-patch"
              ],
              "styles": [
                "src/styles.css"
              ],
              "scripts": [],
              "assets": [
                "src/assets",
                "src/intro",
                "src/WEB-INF",
                {
                  "glob": "**/*",
                  "input": "src/app/shared/services/reader/excel",
                  "output": "src/app/shared/services/reader/excel"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {},
          "configurations": {
            "production": {
              "buildTarget": "koia:build:production"
            },
            "development": {
              "buildTarget": "koia:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "koia:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "koia:build:test",
            "tsConfig": "src/tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": "vitest.config.mts",
            "browsers": [
              "chromiumHeadless"
            ],
            "setupFiles": [
              "src/test-setup.ts"
            ],
            "coverageExclude": [
              "src/app/testing/**"
            ],
            "coverageReporters": [
              "html",
              "lcovonly",
              "text-summary",
              "cobertura"
            ]
          },
          "configurations": {
            "ci": {
              "watch": false,
              "coverage": true,
              "reporters": [
                "default",
                [
                  "junit",
                  {
                    "outputFile": "test-results/junit.xml"
                  }
                ]
              ]
            }
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "koia",
      "style": "css",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "koia",
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false
  }
}
